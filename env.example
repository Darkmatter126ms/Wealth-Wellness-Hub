# ── WealthWell Environment Variables ──
# Copy this file to .env and fill in your own values
# cp .env.example .env

# ── LLM (Groq) ──────────────────────────────
# Required for AI Coach chat feature
# Free key at: https://console.groq.com
# If left blank, AI chat returns a fallback message (everything else works fine)
GROQ_API_KEY=your_groq_api_key_here

# ── Email (Gmail SMTP) ───────────────────────
# Optional — only needed for monthly report emails
# If left blank, email sending is skipped (app works normally)
#
# Setup:
#   1. Enable 2-Step Verification on your Gmail account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an App Password → select "Mail" + "Other"
#   4. Paste the 16-character password below (spaces are fine)
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Server (leave as-is) ─────────────────────
PORT=3001
NODE_ENV=production
